PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=

# JWT — access token short-lived (~15min), refresh token long-lived (~30d), rotated on use
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Must match the mobile/web client origin in production (never *)
FRONTEND_URL=http://localhost:3000

# Cloudinary — required from Milestone 3 onward (document/vehicle photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenWeatherMap — required from Milestone 5 onward (pricing engine's WeatherFactor).
# Free tier permits commercial use with attribution; sign up at openweathermap.org.
OPENWEATHER_API_KEY=

# OpenRouteService — optional. Real road distance/ETA when set; falls back to Haversine
# straight-line distance (with an estimated ETA) when unset or when the API call fails.
# Free tier: 2,500 requests/day. Sign up at openrouteservice.org.
OPENROUTESERVICE_API_KEY=

# Optional configurable external fuel-price source — expected to return { "price": number }.
# No reliable free UAE fuel-price API exists today, so this is normally left unset and
# PricingConfig.currentFuelPrice (manually updated) is used directly.
FUEL_PRICE_EXTERNAL_API_URL=

# Firebase Cloud Messaging service account — not read until Milestone 8 (push notifications)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# The companyCode of the platform's single operational company — Customer job creation
# (POST /jobs) has no company concept in its request at all (GAP-REPORT.md gap #14); the
# backend resolves this company server-side instead of accepting a client-supplied
# companyId/companyCode. Set this to a real company's companyCode (create one via
# POST /companies as an OWNER, then read it back from GET /companies/me) before Customer
# job creation will work. NOT validated at startup like the vars above — read fresh per
# request (job.service.ts's resolveOperationalCompany) so it can be reconfigured without a
# restart; the server logs a warning at boot if this is unset, but still starts.
DEFAULT_COMPANY_CODE=
